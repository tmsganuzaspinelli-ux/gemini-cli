# --- Base de datos ---
# SQLite en un fichero local. No hace falta instalar nada más.
DATABASE_URL="file:./dev.db"

# --- Sesión ---
# Firma las cookies de sesión. MÍNIMO 32 caracteres.
# Genere uno propio con:  openssl rand -base64 48
SESSION_SECRET="cambie-esto-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# --- Profesor Charles (IA) ---
# Opcional. Si la deja vacía, la aplicación funciona igual con el servicio
# simulado: Charles responde con su mismo tono, formato y cinemateca, sin
# gastar cuota. Consiga una clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Modelo a usar. gemini-2.0-flash es rápido y barato; sirve de sobra.
GEMINI_MODEL="gemini-2.0-flash"
